要实现从左图（原生风格）到右图（移动端专业日历）的转变，我们需要对现有的 DatePicker 进行深度改造。这涉及到逻辑增强（注入“入住/离店”状态和节假日）以及样式重写（覆盖 react-datepicker 的默认 CSS）。

以下是完整的代码优化方案：

1. 逻辑与渲染优化 (MapHotelsPage.tsx)
你需要修改 MapHotelsPageInner 组件中的 DatePicker 部分。重点是使用 renderDayContents 来渲染自定义的单元格内容。

TypeScript
// 1. 定义节假日辅助数据（示例）
const HOLIDAY_DATA: Record<string, string> = {
  '2026-02-14': '班/情人节',
  '2026-02-16': '除夕',
  '2026-02-17': '春节',
  '2026-02-28': '班',
};

// 在组件渲染逻辑中修改 DatePicker
<DatePicker
  inline
  selectsRange
  monthsShown={2} // 可以增加到 4-6 个月实现长滚动
  startDate={checkIn}
  endDate={tempEnd ?? checkOut}
  minDate={new Date()}
  calendarClassName="modern-hotel-calendar"
  dayClassName={(date) => {
    // 为周六日添加特殊红色样式类
    const day = date.getDay();
    return (day === 0 || day === 6) ? "is-weekend" : undefined;
  }}
  renderDayContents={(dayOfMonth, date) => {
    if (!date) return dayOfMonth;

    const dateStr = date.toISOString().split('T')[0];
    const isStart = checkIn && date.toDateString() === checkIn.toDateString();
    const isEnd = (tempEnd ?? checkOut) && date.toDateString() === (tempEnd ?? checkOut).toDateString();
    
    // 逻辑：如果是入住第一天显示“今天”，否则显示节假日标签
    const topLabel = isStart ? "今天" : HOLIDAY_DATA[dateStr];
    const bottomLabel = isStart ? "入住" : (isEnd ? "离店" : "");

    return (
      <div className="custom-day-cell">
        <span className={`holiday-tag ${HOLIDAY_DATA[dateStr]?.includes('班') ? 'work-tag' : ''}`}>
          {topLabel}
        </span>
        <span className="day-num">{dayOfMonth}</span>
        <span className="status-tag">{bottomLabel}</span>
      </div>
    );
  }}
  onChange={(range) => {
    /* 保留你原有的 onChange 逻辑 */
    const [start, end] = range as [Date | null, Date | null];
    const norm = (d: Date | null) => {
      if (!d) return null;
      const nd = new Date(d);
      nd.setHours(0, 0, 0, 0);
      return nd;
    };
    const s = norm(start);
    const e = norm(end);
    if (calendarPhase === 'start' && s) {
      setCheckIn(s as Date);
      setTempEnd(null);
      setCalendarPhase('end');
      return;
    }
    if (calendarPhase === 'end') {
      const clicked = e ?? s;
      const target = norm(clicked);
      if (target && target.getTime() > checkIn.getTime()) {
        setCheckOut(target as Date);
        setTempEnd(target as Date);
        setCalendarPhase('start');
        setCoreCalOpen(false);
        const ms = (target.getTime() - checkIn.getTime());
        setNights(Math.max(1, Math.round(ms / (24 * 3600 * 1000))));
      }
    }
  }}
/>
2. 样式重写 (HotelListPage.css)
要达到右图那种“方块感”和颜色布局，必须强制覆盖 react-datepicker 的默认样式。

CSS
/* 容器基本样式 */
.modern-hotel-calendar {
  border: none !important;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
  width: 100% !important;
}

/* 头部星期表头样式优化 */
.modern-hotel-calendar .react-datepicker__header {
  background-color: #fff !important;
  border-bottom: none !important;
  padding-top: 20px !important;
}

.modern-hotel-calendar .react-datepicker__day-name {
  width: 14.28% !important; /* 7等分 */
  margin: 0 !important;
  color: #999;
  font-size: 14px;
}

/* 周末红色标记 */
.modern-hotel-calendar .react-datepicker__day-name:first-child,
.modern-hotel-calendar .react-datepicker__day-name:last-child {
  color: #ff4d4f;
}

/* 自定义单元格容器 */
.custom-day-cell {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  height: 64px; /* 增加高度以容纳三行文字 */
  width: 100%;
  position: relative;
}

.holiday-tag {
  font-size: 10px;
  height: 14px;
  color: #ff4d4f;
  line-height: 14px;
}

.work-tag {
  color: #333 !important; /* “班”字显示为黑色 */
}

.day-num {
  font-size: 18px;
  font-weight: 500;
  line-height: 22px;
}

.status-tag {
  font-size: 10px;
  height: 14px;
  line-height: 14px;
}

/* 选中范围样式覆盖 */
.modern-hotel-calendar .react-datepicker__day {
  width: 14.28% !important;
  margin: 0 !important;
  border-radius: 0 !important; /* 移除圆角，变成方块 */
  transition: background 0.2s;
}

/* 选中态：深蓝色 */
.modern-hotel-calendar .react-datepicker__day--selected,
.modern-hotel-calendar .react-datepicker__day--range-start,
.modern-hotel-calendar .react-datepicker__day--range-end {
  background-color: #1677ff !important;
  color: white !important;
}

/* 范围中间态：淡蓝色 */
.modern-hotel-calendar .react-datepicker__day--in-range:not(.react-datepicker__day--range-start):not(.react-datepicker__day--range-end) {
  background-color: rgba(22, 119, 255, 0.1) !important;
  color: #1677ff !important;
}

/* 禁用日期（过期日期）样式 */
.modern-hotel-calendar .react-datepicker__day--disabled {
  color: #ccc !important;
  background-color: transparent !important;
}

/* 月份标题居左并加粗 */
.modern-hotel-calendar .react-datepicker__current-month {
  text-align: left;
  padding-left: 15px;
  font-size: 20px;
  font-weight: bold;
  margin-bottom: 10px;
}
